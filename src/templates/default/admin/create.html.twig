{% extends '@Admin/' ~ app.request.attributes.get('active_site').templatePath ~ '/base.html.twig' %}


{% block title %} {{ 'New record' | trans }} {% endblock %}
{% block h1 %}{{ 'New record' | trans }} {% endblock %}
{% block breadcrumbs %}
