{% extends '@Admin/' ~ app.request.attributes.get('active_site').templatePath ~ '/base-empty.html.twig' %}
{% block h1 %} {{ 'Admin' | trans }} {% endblock %}

{% block breadcrumbs %}
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_page_main') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Admin</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}

    <hr>
    <div class="row">
        <div class="col-4 mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="card-title">{{ 'Pages' | trans }}</h5>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <p><a href="{{ path('app_main_page_items_admin') }}">{{ 'Main' | trans }} {{ 'Pages' | trans }}</a> ({{ counts.pagesOnMain }}) </p>
                        </div>
                        <div class="col-8 text-end">
                            <p><a href="{{ path('app_page_section_items_admin') }}">{{ 'Pages and sections' | trans }}</a> ({{ counts.pageSections }}/{{ counts.pages }}) </p>
                        </div>
                    </div>
                    <hr>

                    <div class="row">
                        <div class="col-8">
                            <p><a href="{{ path('app_page_items_admin') }}">{{ 'Basket' | trans }}</a> ({{ counts.pagesInBasket }}) </p>
                        </div>
                        <div class="col-4 text-end">
                            <p><a href="#">{{ 'Clear' | trans }}</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4 mt-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><a href="{{ path('app_user_admin_index') }}">{{ 'Users' | trans }}</a> ({{ counts.users }}/{{ counts.usersInBasket }})</h5>
                    {% if counts.users == 0 %}
                        <div class="alert alert-warning">
                            <strong>{{ 'You have no users.' | trans }}
                                <a href="{{ path('app_user_admin_new') }}" class="card-link">{{ 'Create user' | trans }}</a>
                            </strong>
                        </div>
                    {% else %}

                    {% endif %}

                    <p class="card-text">{{ 'Manege users' | trans }}</p>
                    <a href="{{ path('app_user_admin_new') }}" class="card-link">{{ 'Create user' | trans }}</a>
                    {% if counts.users == 0 %}
                    {% else %}
                        <a href="{{ path('app_user_admin_index') }}" class="card-link">{{ 'Users list' | trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-4 mt-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><a href="{{ path('app_role_admin_index') }}">{{ 'Users roles' | trans }}</a> ({{ counts.roles }}/{{ counts.rolseInBasket }})</h5>
                    {% if counts.roles == 0 %}
                        <div class="alert alert-warning">
                            <strong>{{ 'You have no roles.' | trans }}
                                <a href="{{ path('app_role_admin_new') }}" class="card-link">{{ 'Create role' | trans }}</a>
                            </strong>
                        </div>
                    {% else %}

                    {% endif %}

                    <p class="card-text">{{ 'Manege roles' | trans }}</p>
                    <a href="{{ path('app_role_admin_new') }}" class="card-link">{{ 'Create role' | trans }}</a>
                    {% if counts.roles == 0 %}
                    {% else %}
                        <a href="{{ path('app_role_admin_index') }}" class="card-link">{{ 'Roles list' | trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-4 mt-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><a href="{{ path('app_permission_admin_index') }}">{{ 'Users permissions' | trans }}</a> ({{ counts.permissions }}/{{ counts.permissionsInBasket }})</h5>
                    {% if counts.roles == 0 %}
                        <div class="alert alert-warning">
                            <strong>{{ 'You have no permissions.' | trans }}
                                <a href="{{ path('app_permission_admin_new') }}" class="card-link">{{ 'Create permission' | trans }}</a>
                            </strong>
                        </div>
                    {% else %}

                    {% endif %}

                    <p class="card-text">{{ 'Manege permissions.' | trans }}</p>
                    <a href="{{ path('app_permission_admin_new') }}" class="card-link">{{ 'Create permission' | trans }}</a>
                    {% if counts.roles == 0 %}
                    {% else %}
                        <a href="{{ path('app_permission_admin_index') }}" class="card-link">{{ 'Permissions list' | trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
{% endblock %}

